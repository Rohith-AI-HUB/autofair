# Supabase — required for Sign in / Sign up (/auth)
# 1. Create a project at https://supabase.com/dashboard
# 2. Copy Project URL + anon public key from Project Settings → API
# 3. Enable Google provider: Authentication → Sign In / Up → Google
#    (needs a Google Cloud OAuth client ID + secret; add
#    https://<project-ref>.supabase.co/auth/v1/callback as an
#    authorized redirect URI in Google Cloud, then add your site URL
#    e.g. http://localhost:3000/auth/callback under Supabase → URL Configuration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Admin staff creation (server-only, never NEXT_PUBLIC_). Required for POST /api/admin/staff.
# Get it from Supabase Dashboard → Project Settings → API → service_role (secret).
# Without it, the admin dashboard still monitors workload/inspections, but creating
# staff shows a setup message. Create staff manually in Dashboard → Authentication → Users,
# then set public.profiles.role = 'STAFF' for that user.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
# Optional: canonical site URL used for OAuth/email redirects.
# Defaults to window.location.origin in the browser.
# NEXT_PUBLIC_SITE_URL=https://autofair.example.com
# Email notifications (server-only) — Resend free tier: https://resend.com/api-keys
# Used by the /contact form (office alert) and staff assignment notifications.
# Without these keys everything still works, just without email.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Verified sender, e.g. AutoFair <no-reply@autofair.online>
# (for quick testing before a domain is verified: onboarding@resend.dev,
#  which can only deliver to the Resend account owner's own email)
# EMAIL_FROM=no-reply@autofair.online
# Inbox that receives contact-form inquiries. Defaults to autofaironline.co@gmail.com.
# OFFICE_EMAIL=autofaironline.co@gmail.com
